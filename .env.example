# --- Telegram API Credentials (Required) ---
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# --- MongoDB Database (Required) ---
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=WordGridBotDB

# --- Admins & Optional Bot Identity ---
SUDO_USERS=123456789
BOT_USERNAMES=

# --- Community Links & Timezone ---
SUPPORT_GROUP=https://t.me/your_support_group
UPDATE_CHANNEL=https://t.me/your_update_channel
TIME_ZONE=Asia/Kolkata

# --- Optional Gameplay & Cooldown Settings ---
CMD_COOLDOWN=2.0
GAME_START_COOLDOWN=2.5
HINT_COOLDOWN=10.0
REFRESH_COOLDOWN=12.0
CALLBACK_COOLDOWN=1.0
GUESS_COOLDOWN=0.35
MAX_HINTS_PER_ROUND=3
WORDSEEK_MAX_GUESSES=30
PORT=0
